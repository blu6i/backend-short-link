DB__POSTGRES_USER=admin
DB__POSTGRES_PASSWORD=your_database_password
DB__POSTGRES_DB=db
DB__POSTGRES_HOST=localhost
DB__POSTGRES_PORT=5432
DB__ECHO=0
DB__ECHO_POOL=0
DB__POOL_SIZE=50
DB__MAX_OVERFLOW=10

JWT__TOKEN=replace_with_a_long_random_secret
JWT__ALGORITHM=HS256

# Authentication cookies. Use secure=true in HTTPS production.
AUTH__COOKIE_SECURE=false
AUTH__COOKIE_SAMESITE=lax
AUTH__COOKIE_DOMAIN=

LOG__LOG_LEVEL=DEBUG
LOG__LOG_ROTATION='10 MB'
LOG__LOG_RETENTION='7 days'

REDIS__REDIS_HOST=localhost
REDIS__REDIS_PORT=6379
REDIS__REDIS_DB=0
REDIS__REDIS_DB_BROKER=1
REDIS__REDIS_DB_BACKEND=2
REDIS__REDIS_PASSWORD=your_redis_password

URL__URL=http://localhost:8000
SALT__HASHED_IP_SALT=replace_with_a_long_random_salt
API_TOKEN__IP_CHECKED=your_2ip_api_token

AUTH__COOKIE_SECURE=false
AUTH__COOKIE_SAMESITE=lax
AUTH__COOKIE_DOMAIN=

CORS__ALLOWED_ORIGINS=["*"]
CORS__ALLOW_CREDENTIALS=false
CORS__ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS__ALLOW_HEADERS=["*"]
